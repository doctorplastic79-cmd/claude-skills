# Copia questo file in ".env" (stessa cartella) e mettici la tua chiave.
# Il file ".env" è ignorato da git: resta solo sul tuo Mac.
#
#   cp .env.example .env
#   nano .env

ANTHROPIC_API_KEY=sk-ant-...

